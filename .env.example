# Optional: pass to uvicorn with --env-file .env after copying this file.
WOUNDWATCH_DATA_DIR=runtime
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
# Local remains the default. Production requires HTTPS via a trusted proxy.
WOUNDWATCH_ENV=local
# WOUNDWATCH_USERNAME=operator
# WOUNDWATCH_PASSWORD=<set-a-unique-secret-of-at-least-24-characters>
# WOUNDWATCH_ALLOWED_HOSTS=woundwatch.example.org
# For compose, also include 127.0.0.1 for the internal liveness check:
# WOUNDWATCH_ALLOWED_HOSTS=woundwatch.example.org,127.0.0.1
# WOUNDWATCH_DOMAIN=woundwatch.example.org
# Optional, reviewed candidate checkpoint; restart server after changing:
# WOUNDWATCH_SEGMENTER_PATH=experiments/segmenter-retrain-low-memory/candidate.pt
